---
interface Props {
  titulo: string;
  detalle?: string;
}
const { titulo, detalle } = Astro.props;
---

<div class="rounded-xl border border-dashed border-[var(--color-linea)] px-6 py-16 text-center">
  <p class="text-lg font-semibold">{titulo}</p>
  {detalle && <p class="mt-1 text-sm text-[var(--color-tinta-tenue)]">{detalle}</p>}
</div>

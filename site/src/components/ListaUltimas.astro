---
import type { Tarjeta } from "../lib/types";
import { enlaceNoticia, etiquetaCategoria, haceCuanto } from "../lib/format";

interface Props {
  articulos: Tarjeta[];
  titulo?: string;
}

const { articulos, titulo = "Última hora" } = Astro.props;
---

<section class="rounded-xl border border-[var(--color-linea)] bg-[var(--color-lienzo)]">
  <h2
    class="flex items-center gap-2 border-b border-[var(--color-linea)] px-4 py-3 text-sm font-bold uppercase tracking-widest"
  >
    <span class="inline-block size-2 animate-pulse rounded-full bg-[var(--color-marca)]"></span>
    {titulo}
  </h2>

  <ol class="divide-y divide-[var(--color-linea)]">
    {
      articulos.map((articulo, indice) => (
        <li>
          <a
            href={enlaceNoticia(articulo.category, articulo.id)}
            class="flex gap-3 px-4 py-3 transition hover:bg-[var(--color-lienzo-alt)]"
          >
            <span class="pt-0.5 font-display text-lg font-extrabold leading-none text-[var(--color-tinta-tenue)] tabular-nums">
              {String(indice + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0">
              <p class="lineas-3 text-sm font-semibold leading-snug">{articulo.title}</p>
              <p class="mt-1 text-xs text-[var(--color-tinta-tenue)]">
                {etiquetaCategoria(articulo.category)}
                {articulo.published_at && ` · ${haceCuanto(articulo.published_at)}`}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</section>

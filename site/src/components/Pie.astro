---
import type { Indice } from "../lib/types";
import { fecha, numero } from "../lib/format";

interface Props {
  indice: Indice | null;
}
const { indice } = Astro.props;
---

<footer class="mt-8 border-t border-[var(--color-linea)] bg-[var(--color-lienzo)]">
  <div class="contenedor py-6">
    {
      indice && (
        <p class="mb-2 text-sm font-semibold">
          {numero(indice.total_articles)} noticias archivadas en {numero(indice.total_categories)} categorías
          <span class="font-normal text-[var(--color-tinta-tenue)]">
            · actualizado el {fecha(indice.generated_at, true)}
          </span>
        </p>
      )
    }
    <p class="max-w-[65ch] text-xs leading-relaxed text-[var(--color-tinta-tenue)]">
      Archivo generado automáticamente a partir de contenidos publicados en{" "}<a
        href="https://www.marca.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-[var(--color-marca)]">marca.com</a
      >, propiedad de Unidad Editorial. Este sitio no está afiliado a Marca ni a
      Unidad Editorial y se publica con fines de consulta e investigación
      personal; los derechos de cada noticia pertenecen a su editor.
    </p>
  </div>
</footer>

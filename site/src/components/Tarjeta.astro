---
import type { Noticia, Tarjeta } from "../lib/types";
import { colorSeccion, enlaceNoticia, etiquetaCategoria, haceCuanto } from "../lib/format";

type Variante = "apertura" | "normal" | "compacta";

interface Props {
  articulo: Tarjeta | Noticia;
  variante?: Variante;
}

const { articulo, variante = "normal" } = Astro.props;

const imagen = "image" in articulo ? articulo.image : (articulo.images?.[0]?.url ?? null);
const entradilla = articulo.standfirst || articulo.summary;
const enlace = enlaceNoticia(articulo.category, articulo.id);
const color = colorSeccion(articulo.category);
---

{
  variante === "compacta" ? (
    <article class="group flex gap-3 border-b border-[var(--color-linea)] pb-3">
      <a href={enlace} class="shrink-0 overflow-hidden rounded-md bg-[var(--color-lienzo-alt)]">
        {imagen ? (
          <img
            src={imagen}
            alt=""
            loading="lazy"
            decoding="async"
            class="size-20 object-cover transition duration-300 group-hover:scale-105"
          />
        ) : (
          <div class="size-20" />
        )}
      </a>
      <div class="min-w-0">
        <a
          href={`/categoria/${articulo.category}`}
          class="text-[0.65rem] font-bold uppercase tracking-wider hover:underline"
          style={`color:${color}`}
        >
          {etiquetaCategoria(articulo.category)}
        </a>
        <h3 class="lineas-3 font-display text-base font-bold leading-tight">
          <a href={enlace} class="hover:text-[var(--color-marca)]">
            {articulo.title}
          </a>
        </h3>
        {articulo.published_at && (
          <time datetime={articulo.published_at} class="text-xs text-[var(--color-tinta-tenue)]">
            {haceCuanto(articulo.published_at)}
          </time>
        )}
      </div>
    </article>
  ) : (
    <article
      class:list={[
        "group overflow-hidden rounded-xl border border-[var(--color-linea)] bg-[var(--color-lienzo)] shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg",
        variante === "apertura" ? "" : "flex flex-col",
      ]}
    >
      <a href={enlace} class="block overflow-hidden bg-[var(--color-lienzo-alt)]">
        {imagen ? (
          <img
            src={imagen}
            alt=""
            loading={variante === "apertura" ? "eager" : "lazy"}
            decoding="async"
            class:list={[
              "w-full object-cover transition duration-500 group-hover:scale-[1.03]",
              variante === "apertura" ? "aspect-[16/9]" : "aspect-video",
            ]}
          />
        ) : (
          <div class:list={["w-full", variante === "apertura" ? "aspect-[16/9]" : "aspect-video"]} />
        )}
      </a>

      <div class:list={["flex flex-1 flex-col gap-2", variante === "apertura" ? "p-6" : "p-4"]}>
        <div class="flex items-center gap-2">
          <a
            href={`/categoria/${articulo.category}`}
            class="text-xs font-bold uppercase tracking-wider hover:underline"
            style={`color:${color}`}
          >
            {etiquetaCategoria(articulo.category)}
          </a>
          {articulo.is_premium && (
            <span class="rounded bg-[var(--color-marca-claro)] px-1.5 py-0.5 text-[0.6rem] font-bold uppercase tracking-wide text-[var(--color-marca)]">
              Premium
            </span>
          )}
        </div>

        <h3
          class:list={[
            "font-display font-extrabold leading-[1.1] tracking-tight",
            variante === "apertura" ? "text-3xl sm:text-4xl" : "text-lg",
          ]}
        >
          <a href={enlace} class="hover:text-[var(--color-marca)]">
            {articulo.title}
          </a>
        </h3>

        {entradilla && (
          <p
            class:list={[
              "text-[var(--color-tinta-suave)]",
              variante === "apertura" ? "lineas-3 text-base" : "lineas-2 text-sm",
            ]}
          >
            {entradilla}
          </p>
        )}

        <p class="mt-auto flex flex-wrap items-center gap-x-2 pt-1 text-xs text-[var(--color-tinta-tenue)]">
          {articulo.authors?.[0] && <span class="font-semibold">{articulo.authors[0]}</span>}
          {articulo.authors?.[0] && articulo.published_at && <span aria-hidden="true">·</span>}
          {articulo.published_at && (
            <time datetime={articulo.published_at}>{haceCuanto(articulo.published_at)}</time>
          )}
        </p>
      </div>
    </article>
  )
}
